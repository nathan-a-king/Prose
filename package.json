{
  "name": "prose-app",
  "productName": "Prose",
  "version": "1.5.0",
  "type": "module",
  "description": "A minimal markdown editor with AI-powered writing assistance and multi-agent editorial system",
  "author": "Nathan King <nathan@nathanaking.com>",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "app": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --mac --windows --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --windows",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "marked": "^16.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "happy-dom": "^20.0.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.6",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.yourcompany.prose",
    "productName": "Prose",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "server.js",
      "database.js",
      "node_modules/**/*",
      "build/**/*"
    ],
    "files": [
      "build/**/*",
      "server.js",
      "database.js",
      "electron.js",
      "preload.cjs",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "documents.db",
        "to": "documents.db"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
